# ============================================================
# ПрорАКТ — переменные окружения (пример)
# Скопируй в .env и вписать свои значения: cp .env.example .env
# ============================================================

# --- Обязательные ---

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExample-Token-From-BotFather

# PostgreSQL (база создаст схему сама при первом старте)
DB_DSN=postgres://proakt_app:change_me@localhost:5432/proakt?sslmode=disable

# --- Необязательные ---

# Куда складывать фото скрытых работ и сгенерированные акты
FILES_DIR=files

# Имя исполнителя в шапке акта (документы на украинском)
EXECUTOR_NAME=Виконавець

# --- Голосовой ввод (опционально) ---

# Anthropic-совместимый LLM-шлюз (POST {AI_GATEWAY_URL}/messages).
# Пусто — голос выключен, позиции вводятся текстом.
AI_GATEWAY_URL=

# Модель для текста: позиции из расшифровки
AI_MODEL=gemini-3-flash

# Модель для распознавания речи
AI_MODEL_ASR=gemini-2.5-flash

# Ключ шлюза (Bearer / x-api-key), если шлюз его требует
AI_GATEWAY_KEY=
